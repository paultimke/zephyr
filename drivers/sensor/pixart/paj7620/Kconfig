# PAJ7620 gesture sensor configuration options

# Copyright (c) Paul Timke <ptimkec@live.com>
# SPDX-License-Identifier: Apache-2.0

menuconfig PAJ7620
	bool "PAJ7620 gesture sensor driver"
	default y
	depends on DT_HAS_PIXART_PAJ7620_ENABLED
	select I2C if $(dt_compat_on_bus, $(DT_COMPAT_PIXART_PAJ7620), i2c)
	help
	  Enable driver for the PAJ7620 gesture sensor


if PAJ7620

choice PAJ7620_TRIGGER_MODE
	prompt "Trigger mode"
	default PAJ7620_TRIGGER_NONE
	help
	  Specify the type of triggering to be used by the driver

config PAJ7620_TRIGGER_NONE
	bool "No trigger"

config PAJ7620_TRIGGER_GLOBAL_THREAD
	bool "Use global thread"
	depends on GPIO
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_PIXART_PAJ7620),int-gpios)
	select PAJ7620_TRIGGER

config PAJ7620_TRIGGER_OWN_THREAD
	bool "Use own thread"
	depends on GPIO
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_PIXART_PAJ7620),int-gpios)
	select PAJ7620_TRIGGER

endchoice

config PAJ7620_TRIGGER
	bool

if PAJ7620_TRIGGER

config PAJ7620_THREAD_PRIORITY
	int "Thread priority"
	depends on PAJ7620_TRIGGER_OWN_THREAD
	default 10
	help
	  Priority of the thread used by the driver to handle interrupts.

config PAJ7620_THREAD_STACK_SIZE
	int "Thread stack size"
	depends on PAJ7620_TRIGGER_OWN_THREAD
	default 1024
	help
	  Stack size of thread used by the driver to handle interrupts.

endif # PAJ7620_TRIGGER

endif # PAJ7620
